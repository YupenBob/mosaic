<%
/* List page: shows card grid with filter bar.
 * Cards are rendered by the single shared renderer
 * (src/assets/js/cards/render.js) — provided to templates by
 * scripts/site/render.mjs — so SSR and client re-renders share one markup. */
const pageDataTitle = typeof pageTitle !== 'undefined' ? pageTitle : site.title;
const pageDesc = typeof pageDescription !== 'undefined' ? pageDescription : site.description;
const themeCfg = site.themeMode || {};
const experienceCfg = site.experience || {};
const cardCfg = experienceCfg.card || {};
const showThemeMenu = themeCfg.showMenu !== false;
const allowVisitorToggle = themeCfg.allowVisitorToggle !== false;
const themeMenuLabel = t('theme_menu');
const accentOptions = [
  ['blue', 'accent_blue'],
  ['violet', 'accent_violet'],
  ['emerald', 'accent_emerald'],
  ['rose', 'accent_rose'],
  ['amber', 'accent_amber'],
  ['slate', 'accent_slate'],
];
%>
<!DOCTYPE html>
<html lang="<%= site.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= pageDesc %>" />
  <meta name="theme-color" content="#f5f5f7" />
  <meta name="data-base" content="<%= rp %>data" />
  <title><%= pageDataTitle %></title>
  <script>
    /* Apply the pinned theme + accent before first paint (no flash of wrong theme).
     * data-theme = RESOLVED light|dark; data-theme-mode = visitor preference;
     * data-accent = palette. Kept in sync with post.ejs / 404.ejs. */
    (function () {
      try {
        var root = document.documentElement;
        var fallbackMode = '<%= (site.themeMode && site.themeMode.default) || site.theme || "auto" %>';
        var fallbackAccent = '<%= (site.themeMode && site.themeMode.accent) || "blue" %>';
        var mode = localStorage.getItem('mosaic_theme') || fallbackMode;
        var accent = localStorage.getItem('mosaic_accent') || fallbackAccent;
        var dark =
          mode === 'dark' ||
          (mode !== 'light' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        root.setAttribute('data-theme', dark ? 'dark' : 'light');
        root.setAttribute('data-theme-mode', mode === 'light' || mode === 'dark' ? mode : 'auto');
        root.setAttribute('data-accent', accent || 'blue');
      } catch (e) {}
    })();
  </script>
  <link rel="icon" type="image/svg+xml" sizes="any" href="<%= site.favicon ? (site.favicon.indexOf('http') === 0 || site.favicon.startsWith('/') ? site.favicon : rp + site.favicon) : rp + 'assets/logo.svg' %>" />
  <link rel="apple-touch-icon" href="<%= rp %>assets/apple-touch-icon.png" />
  <link rel="stylesheet" href="<%= rp %>assets/remixicon/remixicon.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/tokens.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/reset.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/layout.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/card.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/post.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/gallery.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/video.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/filter.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/motion.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/icons.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/note.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/feed.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/responsive.css" />
  <meta property="og:title" content="<%= pageDataTitle %>" />
  <meta property="og:description" content="<%= pageDesc %>" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= site.url || '' %>" />
  <meta property="og:site_name" content="<%= site.title %>" />
  <meta property="og:image" content="<%= (site.url || '') %>/assets/og-card.png" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= pageDataTitle %>" />
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"WebSite","name":"<%= site.title %>","description":"<%= site.description %>","url":"<%= site.url || '' %>"}
  </script>
<script>window.__MOSAIC_CONFIG=<%- JSON.stringify({ components: site.components || {}, player: site.player, search: site.search, searchMinChars: site.searchMinChars, imageQuality: site.imageQuality, themeMode: site.themeMode, experience: site.experience, apiBase: site.apiBase }).replace(/</g, '\\u003c') %>;</script>
  <script>
    /* Scroll-reveal gating: only hide reveal targets when motion is allowed.
     * The timeout is a safety net — if the app bundle fails to boot, content
     * is revealed instead of staying invisible. */
    (function () {
      try {
        var exp = (window.__MOSAIC_CONFIG && window.__MOSAIC_CONFIG.experience) || {};
        var motion = exp.motion || {};
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var on = motion.enabled !== false && motion.spring !== 'none' && !reduce;
        document.documentElement.setAttribute('data-motion', on ? 'on' : 'off');
        setTimeout(function () {
          if (!document.documentElement.hasAttribute('data-motion-ready')) {
            document.documentElement.setAttribute('data-motion', 'fallback');
          }
        }, 1600);
      } catch (e) {
        document.documentElement.setAttribute('data-motion', 'off');
      }
    })();
  </script>
</head>
<body data-page="list" data-category="<%= activeCategory || '' %>" data-tag="<%= activeTag || '' %>" data-card-size="<%= cardCfg.size || 'large' %>" data-card-image="<%= cardCfg.image || 'full' %>" data-card-layout="<%= cardCfg.layout || 'masonry' %>">

<header class="header">
  <div class="container">
    <a href="<%= rp %>index.html" class="header-logo"><img src="<%= rp %>assets/logo.svg" alt="" class="header-logo-icon" width="28" height="28" /><%= site.title %></a>
    <nav class="header-nav">
      <a href="<%= rp %>index.html" class="<% if (!activeCategory && !activeTag) { %>active<% } %>"><%= t('home') %></a>
      <% if (categories && categories.length) { %>
        <% categories.slice(0, 5).forEach(function(cat) { %>
        <a href="<%= rp %>categories/<%= cat.slug %>/"><%= cat.name %></a>
        <% }); %>
      <% } %>
    </nav>
    <% if (allowVisitorToggle) { %>
    <div class="theme-menu-root">
      <% if (showThemeMenu) { %>
      <button type="button" class="theme-toggle" id="theme-menu-toggle" aria-haspopup="true" aria-expanded="false" aria-controls="theme-menu" aria-label="<%= themeMenuLabel %>" title="<%= themeMenuLabel %>">
        <span class="morph-icon-slot" data-morph-icon="theme" aria-hidden="true"><i class="ri-sun-line icon-fallback-sun"></i><i class="ri-moon-line icon-fallback-moon"></i></span>
      </button>
      <div class="theme-menu" id="theme-menu" hidden>
        <div class="theme-menu-group">
          <span class="theme-menu-label" id="theme-mode-label"><%= t('theme_mode') %></span>
          <div class="theme-modes" role="radiogroup" aria-labelledby="theme-mode-label">
            <label class="theme-mode">
              <input type="radio" class="theme-mode-input" name="mosaic-theme-mode" value="auto" />
              <span class="theme-mode-text"><i class="ri-contrast-2-line" aria-hidden="true"></i><%= t('theme_mode_auto') %></span>
            </label>
            <label class="theme-mode">
              <input type="radio" class="theme-mode-input" name="mosaic-theme-mode" value="light" />
              <span class="theme-mode-text"><i class="ri-sun-line" aria-hidden="true"></i><%= t('theme_mode_light') %></span>
            </label>
            <label class="theme-mode">
              <input type="radio" class="theme-mode-input" name="mosaic-theme-mode" value="dark" />
              <span class="theme-mode-text"><i class="ri-moon-line" aria-hidden="true"></i><%= t('theme_mode_dark') %></span>
            </label>
          </div>
        </div>
        <div class="theme-menu-group">
          <span class="theme-menu-label" id="theme-accent-label"><%= t('theme_accent') %></span>
          <div class="theme-swatches" role="radiogroup" aria-labelledby="theme-accent-label">
            <% accentOptions.forEach(function(option) { const value = option[0]; const labelKey = option[1]; %>
            <label class="theme-swatch" data-accent-option="<%= value %>">
              <input type="radio" class="theme-swatch-input" name="mosaic-theme-accent" value="<%= value %>" />
              <span class="theme-swatch-dot" aria-hidden="true"></span>
              <span class="sr-only"><%= t(labelKey) %></span>
            </label>
            <% }); %>
          </div>
        </div>
      </div>
      <% } else { %>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="<%= t('theme_light') %>" title="<%= t('theme_light') %>">
        <span class="morph-icon-slot" data-morph-icon="theme" aria-hidden="true"><i class="ri-sun-line icon-fallback-sun"></i><i class="ri-moon-line icon-fallback-moon"></i></span>
      </button>
      <% } %>
    </div>
    <% } %>
  </div>
</header>

<main class="main">
  <h1 class="sr-only"><%= site.title %></h1>
  <div class="container">
    <!-- Filter Bar -->
    <div class="filter-bar">
      <!-- Search -->
      <div class="search-container">
        <div class="search-input-wrapper">
          <i class="ri-search-line" aria-hidden="true"></i>
          <input type="text" class="search-input" placeholder="<%= t('search_placeholder') %>" autocomplete="off" aria-label="<%= t('search_placeholder') %>" />
        </div>
      </div>

      <!-- Categories -->
      <% if (categories && categories.length > 1) { %>
      <div class="filter-categories">
        <span class="filter-label"><%= t('categories_label') %>:</span>
        <% categories.forEach(function(cat) { %>
        <button class="filter-pill<% if (activeCategory === cat.name) { %> active<% } %>"
                data-category="<%= cat.name %>">
          <%= cat.name %><span class="count"><%= cat.count %></span>
        </button>
        <% }); %>
      </div>
      <% } %>

      <!-- Tags -->
      <% if (tags && tags.length > 0) { %>
      <div class="filter-tags">
        <span class="filter-label"><%= t('tags_label') %>:</span>
        <% tags.slice(0, 20).forEach(function(tag) { %>
        <button class="filter-pill<% if (activeTag === tag.name) { %> active<% } %>"
                data-tag="<%= tag.name %>">
          #<%= tag.name %><span class="count"><%= tag.count %></span>
        </button>
        <% }); %>
      </div>
      <% } %>
    </div>

    <!-- Card Grid — rendered by the shared cards/render.js module -->
    <div class="card-grid" id="card-grid">
      <% if (posts && posts.length > 0) { %>
        <% let priorityBudget = 2; %>
        <% posts.forEach(function(post) { %>
          <% const priority = Boolean(post.cover) && priorityBudget-- > 0; %>
          <%- renderCard(post, { base: rp, priority: priority }) %>
        <% }); %>
      <% } else { %>
        <%- renderEmptyState(t('no_posts')) %>
      <% } %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div class="pagination">
      <% if (currentPage <= 1) { %><button disabled><%= t('prev_page') %></button><% } else { %><a href="<%= rp %><%= prev %>"><%= t('prev_page') %></a><% } %>
      <span class="page-info"><%= currentPage %> / <%= totalPages %></span>
      <% if (currentPage >= totalPages) { %><button disabled><%= t('next_page') %></button><% } else { %><a href="<%= rp %><%= next %>"><%= t('next_page') %></a><% } %>
    </div>
    <% } %>
  </div>
</main>

<footer class="footer">
  <div class="container">
    <p class="footer-tagline"><%= site.subtitle || '' %></p>
    <p>&copy; <%= new Date().getFullYear() %> <%= site.title %>. <%= t('built_with') %></p>
    <p class="footer-feed"><a href="<%= rp %>feed.xml" title="RSS" aria-label="RSS"><i class="ri-rss-line" aria-hidden="true"></i> RSS</a></p>
  </div>
</footer>

<script>window.__I18N=<%- JSON.stringify(i18n || {}) %>;window.__LANG='<%= site.language || 'zh-CN' %>';</script>
<script type="module" src="<%= rp %>assets/js/app.js"></script>
</body>
</html>
