<!DOCTYPE html>
<html lang="<%= site.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="data-base" content="<%= rp %>data" />
  <title>404 - <%= site.title %></title>
  <script>
    /* Apply the pinned theme + accent before first paint (no flash of wrong theme).
       data-theme is resolved (light|dark); data-theme-mode keeps the preference. */
    (function () {
      try {
        var root = document.documentElement;
        var fallbackMode = '<%= (site.themeMode && site.themeMode.default) || site.theme || "auto" %>';
        var fallbackAccent = '<%= (site.themeMode && site.themeMode.accent) || "blue" %>';
        var mode = localStorage.getItem('mosaic_theme') || fallbackMode;
        var accent = localStorage.getItem('mosaic_accent') || fallbackAccent;
        var dark =
          mode === 'dark' ||
          (mode !== 'light' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        root.setAttribute('data-theme', dark ? 'dark' : 'light');
        root.setAttribute('data-theme-mode', mode === 'light' || mode === 'dark' ? mode : 'auto');
        root.setAttribute('data-accent', accent || 'blue');
      } catch (e) {}
    })();
  </script>
  <link rel="icon" type="image/svg+xml" sizes="any" href="<%= rp %>assets/logo.svg" />
  <link rel="apple-touch-icon" href="<%= rp %>assets/apple-touch-icon.png" />
  <link rel="stylesheet" href="<%= rp %>assets/remixicon/remixicon.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/tokens.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/reset.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/layout.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/motion.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/icons.css" />
<script>window.__MOSAIC_CONFIG=<%- JSON.stringify({ components: site.components || {}, player: site.player, search: site.search, searchMinChars: site.searchMinChars, imageQuality: site.imageQuality, themeMode: site.themeMode, experience: site.experience }).replace(/</g, '\\u003c') %>;</script>
</head>
<body data-page="404">
  <header class="header">
    <div class="container">
      <a href="<%= rp %>index.html" class="header-logo"><img src="<%= rp %>assets/logo.svg" alt="" class="header-logo-icon" width="28" height="28" /><%= site.title %></a>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="<%= t('theme_light') %>" title="<%= t('theme_light') %>">
        <span class="morph-icon-slot" data-morph-icon="theme" aria-hidden="true"><i class="ri-sun-line icon-fallback-sun"></i><i class="ri-moon-line icon-fallback-moon"></i></span>
      </button>
    </div>
  </header>
  <main class="main">
    <div class="container" style="text-align:center;padding:var(--space-20) var(--space-4);">
      <i class="ri-error-warning-line" style="font-size:4rem;color:var(--color-text-tertiary);display:block;margin-bottom:var(--space-6);"></i>
      <h1 style="font-size:var(--font-size-3xl);margin-bottom:var(--space-4);">404</h1>
      <p style="color:var(--color-text-secondary);font-size:var(--font-size-lg);margin-bottom:var(--space-8);"><%= t('page_not_found') %></p>
      <a href="<%= rp %>index.html" style="color:var(--color-accent-text);font-weight:var(--font-weight-medium);"><%= t('back_home') %></a>
    </div>
  </main>
  <footer class="footer">
    <div class="container">
      <p class="footer-tagline"><%= site.subtitle || '' %></p>
      <p>&copy; <%= new Date().getFullYear() %> <%= site.title %>. <%= t('built_with') %></p>
      <p class="footer-feed"><a href="<%= rp %>feed.xml" title="RSS" aria-label="RSS"><i class="ri-rss-line"></i> RSS</a></p>
    </div>
  </footer>
  <script>window.__I18N=<%- JSON.stringify(i18n || {}) %>;window.__LANG='<%= site.language || 'zh-CN' %>';</script>
  <script type="module" src="<%= rp %>assets/js/app.js"></script>
</body>
</html>
