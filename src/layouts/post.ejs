<%
/* Post detail page */
const pageDataTitle = post.title + ' - ' + site.title;

function videoControlsHTML(multiSrc, showNext, total) {
  var h = '<div class="video-controls">';
  h += '<button class="vc-play" aria-label="Play/Pause"><i class="ri-play-fill"></i></button>';
  h += '<div class="vc-volume"><button class="vc-volume-btn" aria-label="Volume"><i class="ri-volume-up-line"></i></button><div class="vc-volume-slider"><input type="range" class="vc-volume-range" min="0" max="100" value="100" /></div></div>';
  h += '<span class="vc-time-current">0:00</span>';
  h += '<div class="vc-progress"><div class="vc-progress-hover" id="vc-time-tooltip">0:00</div><div class="vc-progress-track"><div class="vc-progress-buffer"></div><div class="vc-progress-fill"></div><div class="vc-progress-thumb"></div></div></div>';
  h += '<span class="vc-time-duration">0:00</span>';
  h += '<div class="vc-speed"><button class="vc-speed-btn">1x <i class="ri-arrow-down-s-line"></i></button><div class="vc-speed-menu"></div></div>';
  if (multiSrc) {
    h += '<div class="vc-quality"><button class="vc-quality-btn">Auto <i class="ri-arrow-down-s-line"></i></button><div class="vc-quality-menu"></div></div>';
  }
  if (showNext && total > 1) {
    h += '<button class="vc-next" title="Next video"><i class="ri-skip-forward-line"></i></button>';
  }
  h += '<button class="vc-pip" title="Picture-in-Picture"><i class="ri-picture-in-picture-line"></i></button>';
  h += '<button class="vc-fullscreen" title="Fullscreen"><i class="ri-fullscreen-line"></i></button>';
  h += '</div>';
  return h;
}

function videoElementHTML(vid) {
  var multiSrc = !!(vid.sources);
  var hasHLS = !!(vid.hls);
  var h = '<div class="video-player-overlay"><button class="video-big-play" aria-label="Play"><i class="ri-play-fill"></i></button></div>';
  if (hasHLS) {
    h += '<video preload="metadata" poster="' + (vid.poster || '') + '" class="video-element" data-hls="true">';
    h += '<source src="' + vid.hls + '" type="application/x-mpegURL" />';
    // MP4 tier fallbacks (only consumed if hls.js hits an unrecoverable fatal
    // error, so playback degrades to a file instead of dying).
    if (vid.sources) {
      var hlsResKeys = Object.keys(vid.sources).sort().reverse();
      for (var hr = 0; hr < hlsResKeys.length; hr++) {
        h += '<source data-res="' + hlsResKeys[hr] + '" src="' + vid.sources[hlsResKeys[hr]] + '" type="video/mp4" />';
      }
    }
    h += '</video>';
  } else if (multiSrc) {
    h += '<video preload="metadata" poster="' + (vid.poster || '') + '" class="video-element">';
    var resKeys = Object.keys(vid.sources).sort().reverse();
    for (var r = 0; r < resKeys.length; r++) {
      h += '<source data-res="' + resKeys[r] + '" src="' + vid.sources[resKeys[r]] + '" type="video/mp4" />';
    }
    h += '</video>';
  } else if (vid.src) {
    h += '<video preload="metadata" poster="' + (vid.poster || '') + '" src="' + vid.src + '" class="video-element"></video>';
  }
  return h;
}

function renderVideos(vids, mode) {
  if (!vids || vids.length === 0) return '';
  var html = '<section class="video-section">';

  if (mode === 'playlist' && vids.length > 1) {
    // Playlist mode: containers rendered, only active visible; side panel handled by layout
    html += '<div class="video-playlist-wrap" data-total="' + vids.length + '">';
    vids.forEach(function(vid, i) {
      html += '<div class="video-container" data-video-index="' + i + '"' + (i > 0 ? ' style="display:none"' : '') + '>';
      html += videoElementHTML(vid);
      html += videoControlsHTML(!!vid.sources, false, vids.length);
      html += '</div>';
    });
    html += '</div>';
  } else {
    // Stacked mode: each video has its own player
    vids.forEach(function(vid, i) {
      html += '<div class="video-container" data-video-index="' + i + '" data-total="' + vids.length + '">';
      html += videoElementHTML(vid);
      html += videoControlsHTML(!!vid.sources, true, vids.length);
      html += '</div>';
    });
  }

  html += '</section>';
  return html;
}

function renderGallery(photos, threshold) {
  if (!photos || photos.length === 0) return '';
  var single = threshold && photos.length <= threshold;
  var cls = single ? 'gallery-single' : 'gallery-grid';
  var h = '<section class="gallery-section">';
  h += '<div class="' + cls + '" data-total="' + photos.length + '">';
  photos.forEach(function(p) {
    if (single) {
      h += '<div class="gallery-single-item">';
      h += '<img data-src480="' + p.src480 + '" data-src720="' + p.src720 + '" data-src1080="' + p.src1080 + '" data-src-orig="' + p.srcOrig + '" ';
      h += 'srcset="' + p.src480 + ' 854w, ' + p.src720 + ' 1280w, ' + p.src1080 + ' 1920w" ';
      h += 'sizes="100vw" ';
      h += 'src="' + p.src10p + '" alt="Photo" loading="lazy" onload="this.classList.add(\'loaded\')" />';
      h += '</div>';
    } else {
      h += '<div class="gallery-item">';
      h += '<img data-src480="' + p.src480 + '" data-src720="' + p.src720 + '" data-src1080="' + p.src1080 + '" data-src-orig="' + p.srcOrig + '" ';
      h += 'srcset="' + p.src480 + ' 854w, ' + p.src720 + ' 1280w, ' + p.src1080 + ' 1920w" ';
      h += 'sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw" ';
      h += 'src="' + p.src10p + '" alt="Photo" loading="lazy" onload="this.classList.add(\'loaded\')" />';
      h += '</div>';
    }
  });
  h += '</div></section>';
  return h;
}

function escHtml(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderMusicBlock(tracks) {
  var h = '<section class="music-section"><h2 class="section-title">' + t('music') + '</h2>';
  var hasWaveform = tracks.some(function(t) { return t.waveform && t.waveform.length; });
  if (hasWaveform) {
    h += '<div class="waveform-container" id="music-waveform" style="display:none"><canvas height="80"></canvas></div>';
  }
  h += '<div class="music-track-list">';
  tracks.forEach(function(track, i) {
    h += '<div class="music-track" data-index="' + i + '" role="button" tabindex="0">';
    h += '<i class="ri-music-2-line"></i>';
    h += '<span class="music-track-title">' + escHtml(track.title) + '</span>';
    h += '<span class="music-track-artist">' + escHtml(track.artist) + '</span>';
    h += '</div>';
  });
  h += '</div></section>';
  return h;
}

function renderBlock(block) {
  if (block.type === 'text') return '<div class="post-content">' + block.html + '</div>';
  if (block.type === 'gallery') return renderGallery(block.photos, (site.gallerySingleThreshold || 5));
  if (block.type === 'photo') return renderGallery([block.photo], (site.gallerySingleThreshold || 5));
  if (block.type === 'videos') return renderVideos(block.videos, block.mode || 'stacked');
  if (block.type === 'video') {
    var v = block.video;
    return '<section class="video-section"><div class="video-container" data-video-index="0" data-total="1">' +
      videoElementHTML(v) + videoControlsHTML(!!v.sources, false, 1) +
      '</div></section>';
  }
  if (block.type === 'music') return renderMusicBlock(block.tracks);
  return '';
}
%>
<!DOCTYPE html>
<html lang="<%= site.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= post.description %>" />
  <meta name="data-base" content="<%= rp %>data" />
  <meta name="api-base" content="/api" />
  <title><%= pageDataTitle %></title>
  <link rel="icon" type="image/svg+xml" sizes="any" href="<%= site.favicon ? (site.favicon.indexOf('http') === 0 || site.favicon.startsWith('/') ? site.favicon : rp + site.favicon) : rp + 'assets/logo.svg' %>" />
  <link rel="apple-touch-icon" href="<%= rp %>assets/apple-touch-icon.png" />
  <link rel="stylesheet" href="<%= rp %>assets/remixicon/remixicon.css" />
  <link rel="stylesheet" href="<%= rp %>assets/vendor/highlight-github.min.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/tokens.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/reset.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/layout.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/card.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/post.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/gallery.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/video.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/filter.css" />
  <link rel="stylesheet" href="<%= rp %>assets/css/responsive.css" />
  <meta property="og:title" content="<%= pageDataTitle %>" />
  <meta property="og:description" content="<%= post.description %>" />
    <% var postUrl = (site.url || '') + '/posts/' + post.slug + '/'; %>
  <% if (post.type === 'video') { %><meta property="og:type" content="video.movie" /><% } else { %><meta property="og:type" content="article" /><% } %>
  <meta property="og:url" content="<%= postUrl %>" />
  <% if (post.cover) { %><meta property="og:image" content="<%= post.cover %>" /><% } else { %><meta property="og:image" content="<%= (site.url || '') %>/assets/og-card.png" /><% } %>
  <meta property="og:site_name" content="<%= site.title %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= pageDataTitle %>" />
  <% if (post.cover) { %><meta name="twitter:image" content="<%= post.cover %>" /><% } %>
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"BlogPosting","headline":"<%= post.title %>","description":"<%= post.description %>","datePublished":"<%= post.date %>","url":"<%= postUrl %>"}
  </script>
  <% if (site.enableBusuanzi) { %>
  <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
  <% } %>
</head>
<body data-page="post" data-slug="<%= post.slug %>" data-category="<%= post.category || '' %>" data-tags="<%= (post.tags || []).join(',') %>" data-post-type="<%= post.type || 'text' %>">

<header class="header">
  <div class="container">
    <a href="<%= rp %>index.html" class="header-logo"><img src="<%= rp %>assets/logo.svg" alt="" class="header-logo-icon" width="28" height="28" /><%= site.title %></a>
    <nav class="header-nav">
      <a href="<%= rp %>index.html"><%= t('home') %></a>
      <% if (categories && categories.length) { %>
        <% categories.slice(0, 5).forEach(function(cat) { %>
        <a href="<%= rp %>categories/<%= cat.slug %>/"><%= cat.name %></a>
        <% }); %>
      <% } %>
    </nav>
  </div>
</header>

<main class="main">
  <<%= post.videoMode === 'playlist' && post.videos && post.videos.length > 1 ? 'div class="post-page-wrapper"' : 'div' %>>
  <article class="post-page">
    <!-- Breadcrumb -->
    <nav class="post-breadcrumb">
      <a href="<%= rp %>index.html"><%= t('home') %></a>
      <i class="ri-arrow-right-s-line"></i>
      <a href="<%= rp %>categories/<%= post.category.toLowerCase().replace(/\s+/g, '-') %>/"><%= post.category %></a>
      <i class="ri-arrow-right-s-line"></i>
      <span><%= post.title %></span>
    </nav>
    <!-- Header -->
    <header class="post-header">
      <a href="<%= rp %>categories/<%= post.category.toLowerCase().replace(/\s+/g, '-') %>/" class="post-category"><%= post.category %></a>
      <h1 class="post-title"><%= post.title %></h1>
      <div class="post-meta">
        <% if (post.date) { %>
        <span class="post-meta-item"><i class="ri-calendar-line"></i> <%= post.date.split('T')[0] %></span>
        <% } %>
        <a href="<%= rp %>categories/<%= post.category.toLowerCase().replace(/\s+/g, '-') %>/" class="post-meta-item"><i class="ri-folder-line"></i> <%= post.category %></a>
      </div>
      <% if (post.tags && post.tags.length > 0) { %>
      <div class="post-tags">
        <% post.tags.forEach(function(t) { %>
        <a href="<%= rp %>tags/<%= t.toLowerCase().replace(/\s+/g, '-') %>/" class="post-tag">#<%= t %></a>
        <% }); %>
      </div>
      <% } %>
    </header>

    <!-- Content blocks (ordered: text / gallery / videos / music) -->
    <% (post.blocks || []).forEach(function(block) { %>
      <%- renderBlock(block) %>
    <% }); %>
    <% if (post.music && post.music.length) { %>
    <script>window.__MUSIC_TRACKS=<%- JSON.stringify(post.music).replace(/</g, '\\u003c') %>;</script>
    <% } %>

    <!-- Footer: Stats + Likes -->
    <footer class="post-footer">
      <div class="post-stats">
        <span class="post-stat-item">
          <i class="ri-eye-line"></i>
          <span id="mosaic-views-display"><%= post.stats.views %></span>
          <% if (site.enableBusuanzi) { %><span> / </span><span id="busuanzi_value_page_pv">-</span><% } %>
        </span>
        <span class="post-stat-item">
          <i class="ri-time-line"></i>
          <span id="dwell-time-display">-</span>
        </span>
        <span class="post-stat-item">
          <i class="ri-heart-line"></i>
          <span id="like-count-display"><%= post.stats.likes %></span>
        </span>
      </div>
      <button class="like-button"
              data-slug="<%= post.slug %>"
              data-count="<%= post.stats.likes %>">
        <i class="ri-heart-line"></i>
        <span class="like-count"><%= post.stats.likes %></span>
      </button>
    </footer>

    <% if (prev || next) { %>
    <nav class="post-navigation">
      <% if (prev) { %><a href="<%= rp %>posts/<%= prev.slug %>/" class="post-nav-link post-nav-prev"><i class="ri-arrow-left-line"></i> <%= prev.title %></a><% } %>
      <% if (next) { %><a href="<%= rp %>posts/<%= next.slug %>/" class="post-nav-link post-nav-next"><%= next.title %> <i class="ri-arrow-right-line"></i></a><% } %>
    </nav>
    <% } %>

    <% if (related && related.length > 0) { %>
    <section class="related-posts">
      <h2 class="section-title">Related</h2>
      <div class="related-grid">
        <% related.forEach(function(r) { %>
        <a href="<%= rp %>posts/<%= r.slug %>/" class="related-card">
          <% if (r.cover) { %><div class="related-cover"><img src="<% if ((r.cover.startsWith('http') || r.cover.startsWith('/api/'))) { %><%= r.cover %><% } else { %><%= rp %>posts/<%= r.slug %>/<%= r.cover %><% } %>" alt="" loading="lazy" /></div><% } %>
          <span class="related-title"><%= r.title %></span>
        </a>
        <% }); %>
      </div>
    </section>
    <% } %>

    <% if (site.giscus && site.giscus.repo) { %>
    <div class="comments-section">
      <h2 class="section-title"><%= t('comments_title') %></h2>
      <script src="https://giscus.app/client.js"
        data-repo="<%= site.giscus.repo %>"
        data-repo-id="<%= site.giscus.repoId %>"
        data-category="<%= site.giscus.category %>"
        data-category-id="<%= site.giscus.categoryId %>"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang="<%= site.language || 'zh-CN' %>"
        crossorigin="anonymous"
        async>
      </script>
    </div>
    <% } %>
  </article>

  <% if (post.videoMode === 'playlist' && post.videos && post.videos.length > 1) { %>
  <aside class="post-playlist-panel" data-total="<%= post.videos.length %>">
    <div class="playlist-header"><i class="ri-play-list-2-line"></i> Playlist (<%= post.videos.length %>)</div>
    <div class="playlist-list">
      <% post.videos.forEach(function(vid, i) { %>
      <div class="pl-item<%= i === 0 ? ' active' : '' %>" data-index="<%= i %>">
        <span class="pl-num"><%= i + 1 %></span>
        <span class="pl-title"><%= vid.base || 'Video ' + (i + 1) %></span>
        <i class="ri-play-fill pl-playing"></i>
      </div>
      <% }); %>
    </div>
  </aside>
  <% } %>
  </div>
</main>

<footer class="footer">
  <div class="container">
    <p class="footer-tagline"><%= site.subtitle || '' %></p>
    <p>&copy; <%= new Date().getFullYear() %> <%= site.title %>. <%= t('built_with') %></p>
  </div>
</footer>

<script>window.__I18N=<%- JSON.stringify(i18n || {}) %>;window.__LANG='<%= lang || 'zh-CN' %>';</script>
<script type="module">
import { initI18n } from '<%= rp %>assets/js/data.js';
initI18n(<%- JSON.stringify(i18n || {}) %>, '<%= lang || 'zh-CN' %>');
</script>
  <script src="<%= rp %>assets/vendor/hls.min.js"></script>
  <script src="<%= rp %>assets/vendor/highlight.min.js"></script>
<script>hljs.highlightAll();</script>
<script type="module" src="<%= rp %>assets/js/app.js"></script>
</body>
</html>
