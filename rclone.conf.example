# ──────────────────────────────────────────────
# rclone configuration for Mosaic v0.8
# Copy to ~/.config/rclone/rclone.conf and fill in values.
# Used by GitHub Actions to sync media with R2.
# ──────────────────────────────────────────────

[r2]
type = s3
provider = Cloudflare
access_key_id = YOUR_R2_ACCESS_KEY
secret_access_key = YOUR_R2_SECRET_KEY
endpoint = https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
acl = private
