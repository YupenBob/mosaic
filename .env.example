# Node scripts use explicit environment variables; default checks never load this file.
# Worker local development can use worker/.dev.vars through Wrangler.

# Actions Secrets
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
PIPELINE_SECRET=your_independent_random_pipeline_secret

# Worker Secrets (provision with wrangler secret put)
ADMIN_PASSWORD=your_admin_password
JWT_SECRET=your_random_jwt_secret
GITHUB_TOKEN=your_contents_and_actions_token
CF_ACCOUNT_ID=your_account_id
# PIPELINE_SECRET, R2_ACCESS_KEY and R2_SECRET_KEY also required on Worker.
# PROXY_SECRET must match Pages when the signed IP proxy is used.
PROXY_SECRET=your_existing_proxy_secret

# Worker Vars / Actions Variables; deployment configuration is the default source.
GITHUB_REPO=owner/repository
API_TARGET=https://api.example.com
SITE_BRANCH=main
R2_BUCKET=your_bucket
ALLOWED_ORIGINS=https://admin.example.com
# Optional workflow-level settings before checkout:
MOSAIC_RUNNER=ubuntu-latest
SITE_TIMEOUT_MINUTES=90
MEDIA_TIMEOUT_MINUTES=90

# Local static generation (no credentials or FFmpeg required)
# MEDIA_MANIFEST_FILE=/absolute/path/media-manifest.json
# MOSAIC_DIST=/absolute/path/workspace/dist
# MEDIA_WORK_DIR=/absolute/path/media-temp
