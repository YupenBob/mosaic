# ──────────────────────────────────────────────
# Mosaic v0.8 — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in values.
# For GitHub Actions, add these as repository secrets.
# For Cloudflare Worker, use `wrangler secret put <NAME>`.

# ── R2 (Cloudflare Object Storage) ──────────
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.example.com

# ── Cloudflare ──────────────────────────────
CLOUDFLARE_API_TOKEN=your_cf_api_token
CLOUDFLARE_ACCOUNT_ID=your_cf_account_id

# ── Worker ──────────────────────────────────
# Set these in Worker environment:
#   JWT_SECRET        — random 64-char string for signing tokens
#   ADMIN_PASSWORD_HASH — bcrypt/scrypt hash of admin password
#   GITHUB_TOKEN      — GitHub personal access token (repo scope)
#   GITHUB_OWNER      — GitHub username or org
#   GITHUB_REPO       — repository name
#   R2_PUBLIC_URL     — public media URL

# ── Site ────────────────────────────────────
SITE_URL=https://example.com
SITE_TITLE=Mosaic

# ── Admin ───────────────────────────────────
ADMIN_PASSWORD=change-me
